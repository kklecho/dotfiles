#!/usr/bin/env python3
"""Pull and restore latest encrypted scratch directory backup from remote storage."""

import os
import sys
import socket
import tarfile
import shutil
import tempfile
import subprocess
from datetime import datetime, timezone


def is_s3_path(path):
    """Check if path is an S3 URI."""
    return path.strip().startswith("s3://")


def download_with_s3(s3_uri, local_path):
    """Download file from S3 using aws s3 cp."""
    cmd = [
        "aws", "s3", "cp",
        s3_uri,
        local_path
    ]
    result = subprocess.run(cmd, capture_output=True, text=True)
    return result


def download_with_rsync(remote_path, local_path):
    """Download file using rsync."""
    cmd = [
        "rsync",
        "-avz",
        remote_path,
        local_path,
    ]
    result = subprocess.run(cmd, capture_output=True, text=True)
    return result


def main():
    # 1. Check required environment variables
    path_root = os.environ.get("SCRATCH_SYNC_PATH_ROOT")
    if not path_root or not path_root.strip():
        print("ERROR: SCRATCH_SYNC_PATH_ROOT is not set or empty", file=sys.stderr)
        sys.exit(1)

    enc_key_path = os.environ.get("SCRATCH_SYNC_ENCKEY_LOCAL_PATH")
    if not enc_key_path or not enc_key_path.strip():
        print("ERROR: SCRATCH_SYNC_ENCKEY_LOCAL_PATH is not set or empty", file=sys.stderr)
        sys.exit(1)

    if not os.path.isfile(enc_key_path):
        print(f"ERROR: Encryption key file not found: {enc_key_path}", file=sys.stderr)
        sys.exit(1)

    use_s3 = is_s3_path(path_root)

    # 2. Create temp directory
    temp_dir = tempfile.mkdtemp(prefix="scratchpull_")
    print(f"Created temp directory: {temp_dir}")

    try:
        # Check if latest encrypted file exists on remote
        latest_remote_path = os.path.join(path_root, "scratch_latest.tar.gz.enc")
        latest_local_path = os.path.join(temp_dir, "scratch_latest.tar.gz.enc")

        # Copy latest file from remote if it exists
        if use_s3:
            print(f"Using AWS S3 to download from: {latest_remote_path}")
            result = download_with_s3(latest_remote_path, latest_local_path)
        else:
            result = download_with_rsync(latest_remote_path, latest_local_path)
        
        if result.returncode != 0:
            # File not found on remote
            print(f"Latest file not found on remote: {latest_remote_path}")
            print("Exiting as success (no latest backup available)")
            return

        print(f"Downloaded latest encrypted archive: {latest_local_path}")

        # Decrypt the archive
        decrypted_path = os.path.join(temp_dir, "scratch_latest.tar.gz")
        gpg_cmd = [
            "gpg",
            "--batch",
            "--yes",
            "--passphrase-file", enc_key_path,
            "--output", decrypted_path,
            "--decrypt",
            latest_local_path,
        ]
        result = subprocess.run(gpg_cmd, capture_output=True, text=True)
        if result.returncode != 0:
            print(f"ERROR: Decryption failed: {result.stderr}", file=sys.stderr)
            sys.exit(1)

        print(f"Decrypted to: {decrypted_path}")

        # Extract tar-gzip in temp folder
        extract_dir = os.path.join(temp_dir, "extracted")
        os.makedirs(extract_dir)
        print(f"Extracting to: {extract_dir}")
        with tarfile.open(decrypted_path, "r:gz") as tar:
            tar.extractall(path=extract_dir)

        # Find the extracted scratch directory
        extracted_scratch = None
        for item in os.listdir(extract_dir):
            item_path = os.path.join(extract_dir, item)
            if os.path.isdir(item_path) and item.startswith(".scratch"):
                extracted_scratch = item_path
                break

        if not extracted_scratch:
            print("ERROR: No scratch directory found in archive", file=sys.stderr)
            sys.exit(1)

        print(f"Found extracted scratch directory: {extracted_scratch}")

        # Rsync to local ~/.scratch with backup for replaced files
        local_scratch = os.path.expanduser("~/.scratch")
        os.makedirs(local_scratch, exist_ok=True)

        hostname = socket.gethostname()
        utc_timestamp = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")

        rsync_cmd = [
            "rsync",
            "-avz",
            "--delete",
            "--backup",
            "--backup-dir", temp_dir,
            "--suffix", f".{hostname}.{utc_timestamp}.bak",
            f"{extracted_scratch}/",
            local_scratch,
        ]
        print(f"Rsync: {' '.join(rsync_cmd)}")
        result = subprocess.run(rsync_cmd, capture_output=True, text=True)
        if result.returncode != 0:
            print(f"WARNING: Rsync failed: {result.stderr}", file=sys.stderr)

        print("Pull completed successfully")

    finally:
        # Clean up temp directory
        if os.path.exists(temp_dir):
            shutil.rmtree(temp_dir)
            print(f"Cleaned up temp directory: {temp_dir}")


if __name__ == "__main__":
    main()
