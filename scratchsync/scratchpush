#!/usr/bin/env python3
"""Push encrypted scratch directory backup to remote storage."""

import os
import sys
import socket
import tarfile
import shutil
import tempfile
import subprocess
from datetime import datetime, timezone


def main():
    # 1. Check required environment variables
    path_root = os.environ.get("SCRATCH_SYNC_PATH_ROOT")
    if not path_root or not path_root.strip():
        print("ERROR: SCRATCH_SYNC_PATH_ROOT is not set or empty", file=sys.stderr)
        sys.exit(1)

    enc_key_path = os.environ.get("SCRATCH_SYNC_ENCKEY_LOCAL_PATH")
    if not enc_key_path or not enc_key_path.strip():
        print("ERROR: SCRATCH_SYNC_ENCKEY_LOCAL_PATH is not set or empty", file=sys.stderr)
        sys.exit(1)

    if not os.path.isfile(enc_key_path):
        print(f"ERROR: Encryption key file not found: {enc_key_path}", file=sys.stderr)
        sys.exit(1)

    scratch_dir = os.path.expanduser("~/.scratch")
    if not os.path.exists(scratch_dir):
        print(f"WARNING: Scratch directory not found: {scratch_dir}. Creating empty archive.", file=sys.stderr)

    # 2. Create temp directory
    temp_dir = tempfile.mkdtemp(prefix="scratchpush_")
    print(f"Created temp directory: {temp_dir}")

    try:
        # 3. Create tar-gzip archive
        hostname = socket.gethostname()
        utc_timestamp = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
        archive_name = f"{hostname}_scratch.{utc_timestamp}.tar.gz"
        archive_path = os.path.join(temp_dir, archive_name)

        print(f"Creating archive: {archive_path}")
        with tarfile.open(archive_path, "w:gz") as tar:
            tar.add(scratch_dir, arcname=os.path.basename(scratch_dir))

        # 4. Encrypt the archive
        enc_archive_name = f"{archive_name}.enc"
        enc_archive_path = os.path.join(temp_dir, enc_archive_name)

        print(f"Encrypting to: {enc_archive_path}")
        gpg_cmd = [
            "gpg",
            "--batch",
            "--yes",
            "--passphrase-file", enc_key_path,
            "--output", enc_archive_path,
            "--symmetric",
            "--cipher-algo", "AES256",
            archive_path,
        ]
        result = subprocess.run(gpg_cmd, capture_output=True, text=True)
        if result.returncode != 0:
            print(f"ERROR: Encryption failed: {result.stderr}", file=sys.stderr)
            sys.exit(1)

        # 5. Create latest copy
        latest_path = os.path.join(temp_dir, "scratch_latest.tar.gz.enc")
        shutil.copy2(enc_archive_path, latest_path)
        print(f"Created latest copy: {latest_path}")

        # 6. Rsync both encrypted files to target locations
        files_to_sync = [enc_archive_name, "scratch_latest.tar.gz.enc"]
        for filename in files_to_sync:
            src_path = os.path.join(temp_dir, filename)
            # Build destination path from root
            dest_path = os.path.join(path_root, filename)
            rsync_cmd = [
                "rsync",
                "-avz",
                "--delete",
                src_path,
                dest_path,
            ]
            print(f"Rsync: {' '.join(rsync_cmd)}")
            result = subprocess.run(rsync_cmd, capture_output=True, text=True)
            if result.returncode != 0:
                print(f"WARNING: Rsync failed for {filename}: {result.stderr}", file=sys.stderr)

        print("Push completed successfully")

    finally:
        # Clean up temp directory
        if os.path.exists(temp_dir):
            shutil.rmtree(temp_dir)
            print(f"Cleaned up temp directory: {temp_dir}")


if __name__ == "__main__":
    main()
