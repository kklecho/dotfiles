#!/usr/bin/env python3
import os
import sys
import subprocess


def main():
    script_dir = os.path.dirname(os.path.abspath(__file__))
    pull_script = os.path.join(script_dir, "scratchpull")
    push_script = os.path.join(script_dir, "scratchpush")

    if not os.path.isfile(pull_script):
        print(f"ERROR: Pull script not found: {pull_script}", file=sys.stderr)
        sys.exit(1)
    
    if not os.path.isfile(push_script):
        print(f"ERROR: Push script not found: {push_script}", file=sys.stderr)
        sys.exit(1)

    print("=== Executing scratch pull ===")
    result = subprocess.run([sys.executable, pull_script], env=os.environ.copy())
    if result.returncode != 0:
        print(f"ERROR: Pull failed with exit code {result.returncode}", file=sys.stderr)
        sys.exit(1)
    print("Scratch pull completed successfully")

    print("\n=== Executing scratch push ===")
    result = subprocess.run([sys.executable, push_script], env=os.environ.copy())
    if result.returncode != 0:
        print(f"ERROR: Push failed with exit code {result.returncode}", file=sys.stderr)
        sys.exit(1)
    print("Scratch push completed successfully")

    print("\n=== Scratch sync completed ===")


if __name__ == "__main__":
    main()
