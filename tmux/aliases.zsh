alias tas="tmux attach-session"
alias tmux-j-here='ln -s ~/.dotfiles/tmux/tmux.conf.symlink.j ~/.tmux.conf'
alias tmux-k-here='ln -s ~/.dotfiles/tmux/tmux.conf.symlink.k ~/.tmux.conf'
alias tmux-h-here='ln -s ~/.dotfiles/tmux/tmux.conf.symlink.h ~/.tmux.conf'
alias tmux-cfg-howto="echo 'run on target machine:\nwget -O ~/.tmux.conf https://raw.githubusercontent.com/kklecho/dotfiles/refs/heads/master/tmux/tmux.conf.symlink.j'"

